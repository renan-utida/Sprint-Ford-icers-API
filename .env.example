# SPECRADAR API — Variáveis de Ambiente Necessárias
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env — está no .gitignore

SPRING_PROFILE=dev

ORACLE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:orcl
ORACLE_USER=seu_rm_aqui
ORACLE_PASSWORD=sua_senha_aqui

JWT_SECRET=gere-uma-chave-de-pelo-menos-64-caracteres-aqui

LLM_API_KEY=sua-chave-do-google-ai-studio-aqui
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# gemini-1.5-flash foi desativado pelo Google (retorna 404). Use um
# modelo Flash estável atual — confirme a lista disponível pra sua
# chave em GET /v1beta/models?key=SUA_CHAVE antes de trocar.
LLM_MODEL=gemini-3.7-flash

SERVER_PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081